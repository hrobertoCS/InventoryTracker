<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".DeleteItem">

    <Button
        android:id="@+id/button9"
        android:layout_width="150dp"
        android:layout_height="50dp"
        android:layout_marginTop="100dp"
        android:layout_marginEnd="18dp"
        android:backgroundTint="#8BC2ED"
        android:text="Cancel"
        android:textSize="16sp"
        app:cornerRadius="8sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/itemName3" />

    <Button
        android:id="@+id/button8"
        android:layout_width="150dp"
        android:layout_height="50dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="100dp"
        android:backgroundTint="#8BC2ED"
        android:text="Delete Item"
        android:textSize="16sp"
        app:cornerRadius="8sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/itemName3" />

    <EditText
        android:id="@+id/itemName3"
        android:layout_width="320dp"
        android:layout_height="50dp"
        android:layout_marginStart="59dp"
        android:layout_marginTop="192dp"
        android:layout_marginEnd="340dp"
        android:hint="Item ID"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.045"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/addItem2" />

    <TextView
        android:id="@+id/addItem2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="154dp"
        android:layout_marginTop="112dp"
        android:layout_marginEnd="155dp"
        android:text="Delete Item"
        android:textColor="#6D97B6"
        android:textSize="25sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/itemName"
        android:layout_width="320dp"
        android:layout_height="50dp"
        android:layout_marginStart="59dp"
        android:layout_marginTop="92dp"
        android:layout_marginEnd="340dp"
        android:hint="Item Name"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.045"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/addItem2" />

</androidx.constraintlayout.widget.ConstraintLayout>